SECRET_KEY=
DATABASE_URL=
BASE_URL=https://neuraltrend.org

EMAIL_USER=
EMAIL_PASS=
ADMIN_EMAILS=

# Required for every email listed in ADMIN_EMAILS, or /admin/* returns 503.
# One admin: ADMIN_TOTP_SECRET. Multiple admins: ADMIN_TOTP_SECRETS as a JSON
# object mapping each admin email (lowercase) to its own base32 secret.
# Generate with: python tools/generate_admin_totp_secret.py --email you@example.com
# Never commit a real secret here.
ADMIN_TOTP_SECRET=
ADMIN_TOTP_SECRETS=

STRIPE_SECRET_KEY=
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_ANNUAL_PRICE_ID=
STRIPE_WEBHOOK_SECRET=
STRIPE_BILLING_PORTAL_CONFIGURATION_ID=

REDIS_URL=
FORWARD_RECORD_STORAGE_DIR=

NEURALTREND_LOG_FORMAT=json
NEURALTREND_LOG_LEVEL=INFO
NEURALTREND_SLOW_REQUEST_SECONDS=2.0

# Admin backup UI. On Render, point this to a directory inside the persistent disk.
NEURALTREND_BACKUP_DIR=
NEURALTREND_BACKUP_RETENTION=10

# Google AdSense. Leave unset/false until consent + placement are reviewed.
ADSENSE_ENABLED=false
